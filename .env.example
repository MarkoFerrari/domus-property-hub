# ---------------------------------------------------------------------------
# Domus — environment
#
# Copy this file to `.env` and paste in your two Supabase values.
# Without these, Domus runs in DEMO MODE (data saved in your browser only).
# With them, you get real accounts, real email verification and a real database.
#
# Where to find them: supabase.com -> your project -> Settings -> API
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
